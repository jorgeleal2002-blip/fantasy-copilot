{
  "name": "doctor-x-stein",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sleeper-connected dynasty fantasy football assistant",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "access-code": "node -e \"const c=(process.argv[1]||'').toUpperCase().replace(/[\\s-]+/g,'');if(!c){console.error('usage: npm run access-code NEWCODE');process.exit(1)}console.log(require('crypto').createHash('sha256').update(c).digest('hex'))\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
